{
  "$schema": "https://opencode.ai/config.json",
  "shell": "powershell",
  "mcp": {
    "delegation": {
      "type": "local",
      "command": [
        "node",
        "mcp/delegation/src/index.ts"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 2400000
    }
  },
  "agent": {
    "general": {
      "permission": {
        "ctx_*": "deny"
      }
    },
    "orchestrator": {
      "mode": "primary",
      "description": "The factory manager. Sole entry point; sole writer of BOARD.md; dispatches all other agents.",
      "permission": {
        "edit": {
          "BOARD.md": "allow",
          "INTENT.md": "allow",
          "QUESTIONS_FOR_CLIENT.md": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git reset*--hard*": "deny",
          "rm -rf*": "deny"
        },
        "task": {
          "*": "deny"
        },
        "ctx_*": "deny",
        "delegation_*": "allow",
        "skill": {
          "*": "deny",
          "agent-dispatcher": "allow",
          "async-unblocker": "allow",
          "brainstorming": "allow",
          "configure-delegation": "allow",
          "context-engineering": "allow",
          "core-router": "allow",
          "dispatching-parallel-agents": "allow",
          "domain-modeling": "allow",
          "emergency-halt": "allow",
          "intent-extractor": "allow",
          "meta-debugger": "allow",
          "state-manager": "allow",
          "strategic-compact": "allow",
          "subagent-driven-development": "allow",
          "using-superpowers": "allow",
          "verification": "allow",
          "verification-before-completion": "allow",
          "writing-plans": "allow",
          "finishing-a-development-branch": "allow"
        }
      }
    },
    "architect": {
      "mode": "subagent",
      "description": "Turns INTENT into a spec, CONSTRAINTS.md, and gated tickets. Writes no production code.",
      "permission": {
        "edit": {
          "docs/specs/**": "allow",
          "CONSTRAINTS.md": "allow",
          "tickets/**": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*--hard*": "deny",
          "rm -rf*": "deny"
        },
        "task": {
          "*": "deny"
        },
        "ctx_*": "deny",
        "webfetch": "allow",
        "delegation_*": "deny",
        "delegation_ticket_write": "allow",
        "skill": {
          "*": "deny",
          "aspnet-core": "allow",
          "brainstorming": "allow",
          "constraint-setter": "allow",
          "context-engineering": "allow",
          "design-language": "allow",
          "domain-modeling": "allow",
          "dotnet-webapi": "allow",
          "frontend-design": "allow",
          "security-threat-model": "allow",
          "spec-creator": "allow",
          "system-designer": "allow",
          "task-breakdown": "allow",
          "writing-plans": "allow"
        }
      }
    },
    "senior-dev": {
      "mode": "subagent",
      "description": "Implements tickets in thin verifiable slices; decomposes tickets and delegates mechanical boilerplate to junior-dev; leaves the tree dirty for review (never commits).",
      "permission": {
        "edit": {
          "src/**": "allow",
          "tests/**": "allow",
          "backend/**": "allow",
          "frontend/**": "allow",
          "*": "allow"
        },
        "bash": {
          "*": "allow",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*--hard*": "deny"
        },
        "task": {
          "*": "deny"
        },
        "ctx_*": "deny",
        "webfetch": "allow",
        "delegation_*": "allow",
        "skill": {
          "*": "deny",
          "apply-design": "allow",
          "aspnet-core": "allow",
          "avoid-ai-design": "allow",
          "code-simplifier": "allow",
          "composition-patterns": "allow",
          "configuring-opentelemetry-dotnet": "allow",
          "core-implementer": "allow",
          "create-datadriven-aspnetcore": "allow",
          "debugging-and-error-recovery": "allow",
          "delegate-task": "allow",
          "design-language": "allow",
          "design-review": "allow",
          "dotnet-webapi": "allow",
          "e2e-and-browser-testing": "allow",
          "executing-plans": "allow",
          "find-bugs": "allow",
          "frontend-design": "allow",
          "incremental-implementation": "allow",
          "mentorship": "allow",
          "nexabasis-architecture": "allow",
