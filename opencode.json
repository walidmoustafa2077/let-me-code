          "*": "deny",
          "code-simplifier": "allow",
          "minimalism-enforcer": "allow",
          "refactoring-and-simplification": "allow"
        }
      }
    },
    "tech-writer": {
      "mode": "subagent",
      "description": "Documentation and retrospective writer. Produces docs/ADRs and improves the factory after a feature lands.",
      "permission": {
        "edit": {
          "docs/**": "allow",
          "README.md": "allow",
          "CONSTRAINTS.md": "allow",
