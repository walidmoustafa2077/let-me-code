          "e2e-and-browser-testing": "allow",
          "find-bugs": "allow",
          "react-best-practices": "allow",
          "requesting-code-review": "allow",
          "review-protocol": "allow",
          "root-cause-debugging": "allow",
          "security-best-practices": "allow",
          "security-hardening": "allow",
          "security-review": "allow",
          "systematic-debugging": "allow",
          "test-driven-development": "allow",
          "verification": "allow",
          "verification-before-completion": "allow",
          "security-ownership-map": "allow",
          "design-taste-frontend": "allow"
        }
      }
    },
    "git-agent": {
      "mode": "subagent",
      "description": "The only git writer. Stages and commits verified work only; never commits unverified changes; never pushes.",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git reset*--hard*": "deny",
          "rm -rf*": "deny"
        },
        "task": {
          "*": "deny"
        },
        "ctx_*": "deny",
        "webfetch": "deny",
        "delegation_*": "deny",
        "skill": {
          "*": "deny",
          "branch-hygiene": "allow",
          "commit-conventions": "allow",
          "git-workflow": "allow",
          "git-rewrite-history": "allow"
        }
      }
    },
    "challenger": {
      "mode": "subagent",
      "description": "Adversarial plan reviewer. Stress-tests the spec, constraints, and tickets before any code is written.",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*--hard*": "deny",
          "rm -rf*": "deny"
        },
        "task": {
          "*": "deny"
        },
        "ctx_*": "deny",
